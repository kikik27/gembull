# GemBull Telegram Distribution Bot Configuration

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# NEAR Network & Contract
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
GEMBULL_CONTRACT_ID=gembull-core.testnet

# Distributor Wallet Signer (Required for automated transactions)
# Account ID and ed25519 private key with GEMBULL public allocation
DISTRIBUTOR_ACCOUNT_ID=gembull-public.testnet
DISTRIBUTOR_PRIVATE_KEY=ed25519:your_private_key_here

# Default distribution amount per tester (in whole tokens)
DISTRIBUTION_AMOUNT=5000

# Optional: Upstash Redis (to sync waitlist queue with the web app)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
